APP_NAME=ShopEase User Service
APP_VERSION=1.0.0
APP_PORT=8004
DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=shopease_user_db
DB_USER=shopease_user
DB_PASSWORD=replace-with-a-strong-user-db-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# MUST be copied exactly from the existing shopease-auth-service .env.
JWT_SECRET_KEY=replace-with-the-exact-auth-service-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=shopease-auth-service
